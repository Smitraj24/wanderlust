<% layout("admin/layout") %>

<h2 class="admin-page-title"><i class="fa-solid fa-chart-line me-2 text-danger"></i>Dashboard Overview</h2>

<div class="row g-4 mb-4">
  <div class="col-md-4">
    <a href="/admin/listings" class="text-decoration-none">
      <div class="card stat-card h-100 border-0">
        <div class="card-body d-flex align-items-center p-4">
          <div class="rounded-3 bg-danger bg-opacity-10 p-3 me-3">
            <i class="fa-solid fa-list fa-xl text-danger"></i>
          </div>
          <div>
            <h6 class="text-muted mb-1 small text-uppercase fw-600">Total Listings</h6>
            <h3 class="mb-0 fw-bold text-dark"><%= totalListings %></h3>
            <span class="small text-primary">View all →</span>
          </div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/admin/reviews" class="text-decoration-none">
      <div class="card stat-card h-100 border-0">
        <div class="card-body d-flex align-items-center p-4">
          <div class="rounded-3 bg-warning bg-opacity-15 p-3 me-3">
            <i class="fa-solid fa-star fa-xl text-warning"></i>
          </div>
          <div>
            <h6 class="text-muted mb-1 small text-uppercase fw-600">Total Reviews</h6>
            <h3 class="mb-0 fw-bold text-dark"><%= totalReviews %></h3>
            <span class="small text-primary">View all →</span>
          </div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/admin/users" class="text-decoration-none">
      <div class="card stat-card h-100 border-0">
        <div class="card-body d-flex align-items-center p-4">
          <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3">
            <i class="fa-solid fa-users fa-xl text-primary"></i>
          </div>
          <div>
            <h6 class="text-muted mb-1 small text-uppercase fw-600">Total Users</h6>
            <h3 class="mb-0 fw-bold text-dark"><%= totalUsers %></h3>
            <span class="small text-primary">View all →</span>
          </div>
        </div>
      </div>
    </a>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card admin-card border-0 h-100">
      <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-clock-rotate-left me-2 text-danger"></i>Recent Listings</h5>
        <a href="/admin/listings" class="btn btn-sm btn-outline-danger">View All</a>
      </div>
      <div class="card-body p-0">
        <% if (recentListings.length === 0) { %>
          <div class="p-4 text-center text-muted">
            <i class="fa-solid fa-inbox fa-2x mb-2 opacity-50"></i>
            <p class="mb-0">No listings yet.</p>
          </div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% for (let l of recentListings) { %>
              <a href="/admin/listings/<%= l._id %>" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0">
                <% if (l.image && l.image.url) { %>
                  <img src="<%= l.image.url %>" alt="" class="rounded me-3" style="width:48px;height:48px;object-fit:cover;">
                <% } else { %>
                  <div class="rounded bg-secondary bg-opacity-25 me-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="fa-solid fa-image text-muted"></i>
                  </div>
                <% } %>
                <div class="flex-grow-1 min-w-0">
                  <h6 class="mb-0 text-dark text-truncate"><%= l.title %></h6>
                  <small class="text-muted"><%= l.owner ? l.owner.username : '—' %> · ₹ <%= l.price ? Number(l.price).toLocaleString('en-IN') : 'N/A' %></small>
                </div>
                <i class="fa-solid fa-chevron-right text-muted ms-2"></i>
              </a>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card admin-card border-0 h-100">
      <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-comments me-2 text-warning"></i>Recent Reviews</h5>
        <a href="/admin/reviews" class="btn btn-sm btn-outline-warning">View All</a>
      </div>
      <div class="card-body p-0">
        <% if (recentReviews.length === 0) { %>
          <div class="p-4 text-center text-muted">
            <i class="fa-solid fa-star fa-2x mb-2 opacity-50"></i>
            <p class="mb-0">No reviews yet.</p>
          </div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% for (let r of recentReviews) { %>
              <div class="list-group-item py-3 border-0">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <strong class="text-dark"><%= r.author ? r.author.username : 'Unknown' %></strong>
                  <span class="badge bg-warning text-dark"><%= r.rating %> ★</span>
                </div>
                <p class="mb-0 small text-muted"><%= (r.comment || '').slice(0, 80) %><%= (r.comment && r.comment.length > 80) ? '…' : '' %></p>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
