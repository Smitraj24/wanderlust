<% layout("admin/layout") %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
  <h2 class="admin-page-title mb-0"><i class="fa-solid fa-file-lines me-2 text-danger"></i><%= listing.title %></h2>
  <div class="d-flex gap-2">
    <a href="/admin/listings/<%= listing._id %>/edit" class="btn btn-secondary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
    <form method="POST" action="/admin/listings/<%= listing._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Delete this listing?');">
      <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Delete</button>
    </form>
    <a href="/admin/listings" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
  </div>
</div>

<div class="card admin-card border-0 mb-4 overflow-hidden">
  <% if (listing.image && listing.image.url) { %>
    <img src="<%= listing.image.url %>" class="card-img-top" alt="" style="max-height: 400px; object-fit: cover;">
  <% } %>
  <div class="card-body p-4">
    <div class="d-flex flex-wrap gap-3 mb-3">
      <span class="badge bg-secondary"><%= listing.category || '—' %></span>
      <span class="text-muted">Owner: <strong><%= listing.owner ? listing.owner.username : '—' %></strong></span>
    </div>
    <p class="card-text text-muted mb-3"><%= listing.description %></p>
    <p class="mb-1"><strong>₹ <%= listing.price ? Number(listing.price).toLocaleString('en-IN') : 'N/A' %></strong></p>
    <p class="mb-0 text-muted"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></p>
  </div>
</div>

<div class="card admin-card border-0">
  <div class="card-header bg-white border-0 py-3">
    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-star me-2 text-warning"></i>Reviews (<%= listing.reviews ? listing.reviews.length : 0 %>)</h5>
  </div>
  <div class="card-body p-0">
    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <div class="list-group list-group-flush">
        <% for (let r of listing.reviews) { %>
          <div class="list-group-item py-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <strong><%= r.author ? r.author.username : 'Unknown' %></strong>
                <span class="badge bg-warning text-dark ms-2"><%= r.rating %> ★</span>
                <p class="mb-2 mt-1 text-muted"><%= r.comment %></p>
                <form method="POST" action="/admin/reviews/<%= r._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Delete this review?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="p-4 text-center text-muted">
        <i class="fa-solid fa-star fa-2x mb-2 opacity-25"></i>
        <p class="mb-0">No reviews yet.</p>
      </div>
    <% } %>
  </div>
</div>
