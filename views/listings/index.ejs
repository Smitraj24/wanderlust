<% layout("/layouts/boilerplate") %>

  <style>
    #filters{
        display: flex;
        flex-wrap: wrap;
    }

    .filter{
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        opacity: 0.7;
        align-items: center;
    }
    .filter:hover{
          opacity: 1;
          cursor: pointer;
    }
    .filter p{
        font-size: 0.8rem;
    }

    .text-toggle{
        border: 1px solid black;
        border-radius: 1rem;
        height:  3.25rem;
        padding:  1rem ;
         margin-top: 1rem;
        margin-left: 5rem;
        display: flex;
        align-items: center;
        
    }
  </style>
  
<div id="filters">
    <div class="filter" data-category="trending">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>
    <div class="filter" data-category="rooms">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>
    <div class="filter" data-category="iconic">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </div>
    <div class="filter" data-category="mountains">
        <div><i class="fa-solid fa-mountain-sun"></i></div>
        <p>Mountains</p>
    </div>
    <div class="filter" data-category="castles">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div>
    <div class="filter" data-category="pools">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </div>
    <div class="filter" data-category="camping">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div>
    <div class="filter" data-category="farms">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Farms</p>
    </div>
    <div class="filter" data-category="arctic">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Arctic</p>
    </div>
    <div class="filter" data-category="domes">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Domes</p>
    </div>
    <div class="filter" data-category="boats">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </div>
    <div class="text-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after Taxes</label>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const filters = document.querySelectorAll(".filter");

        filters.forEach(filter => {
            filter.addEventListener("click", () => {
                const category = filter.getAttribute("data-category");
                // Redirect to /listings?category=mountains etc.
                window.location.href = `/listings?category=${category}`;
            });
        });
    });
</script>



<% if (listings.length===0) { %>
    <p class="text-center text-muted">
        No results found for "<%= searchQuery %>"
    </p>
    <% } else { %>
   <div class="container mt-5">

  <div class="row g-4">

    <% for(let listing of listings) { %>
      <% const lid = listing._id.toString(); const inWishlist = typeof wishlistIds !== 'undefined' && wishlistIds.includes(lid); const inCart = typeof cartIds !== 'undefined' && cartIds.includes(lid); %>
      <div class="col-lg-4 col-md-6 col-sm-12">
        <div class="modern-card position-relative">
          <% if(currUser) { %>
          <div class="listing-actions position-absolute top-0 end-0 p-2 d-flex gap-1" style="z-index:5">
            <form method="POST" action="/wishlist/<%= listing._id %>" class="d-inline">
              <button type="submit" class="btn btn-sm rounded-circle p-2" style="background:rgba(255,255,255,0.9);" title="<%= inWishlist ? 'Remove from wishlist' : 'Add to wishlist' %>">
                <i class="fa-<%= inWishlist ? 'solid' : 'regular' %> fa-heart text-danger"></i>
              </button>
            </form>
            <form method="POST" action="/cart/<%= listing._id %>" class="d-inline">
              <button type="submit" class="btn btn-sm rounded-circle p-2" style="background:rgba(255,255,255,0.9);" title="<%= inCart ? 'Remove from cart' : 'Add to cart' %>">
                <i class="fa-solid fa-cart-shopping <%= inCart ? 'text-danger' : '' %>"></i>
              </button>
            </form>
          </div>
          <% } %>
          <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
            <div class="image-wrapper">
              <img src="<%= listing.image.url %>" alt="listing_image">
            </div>
            <div class="card-info">
              <h5 class="listing-title"><%= listing.title %></h5>
              <p class="listing-price" data-base-price="<%= listing.price || 0 %>">
                <span class="price-display">₹ <%= listing.price ? Number(listing.price).toLocaleString("en-IN") : "N/A" %></span>
              </p>
            </div>
          </a>
        </div>
      </div>
    <% } %>

  </div>

</div>


        <% } %>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const taxSwitch = document.getElementById("switchCheckDefault"); 
        const priceElements = document.querySelectorAll(".listing-price");

        taxSwitch.addEventListener("change", () => {
            const showAfterGst = taxSwitch.checked;
            priceElements.forEach(el => {
                const basePrice = parseFloat(el.getAttribute("data-base-price")) || 0;
                const priceSpan = el.querySelector(".price-display");
                if (!priceSpan) return;
                if (basePrice === 0) {
                    priceSpan.textContent = "₹ N/A";
                    return;
                }
                if (showAfterGst) {
                    const priceWithGst = Math.round(basePrice * 1.18);
                    priceSpan.textContent = "₹ " + priceWithGst.toLocaleString("en-IN") + " (incl. 18% GST)";
                } else {
                    priceSpan.textContent = "₹ " + basePrice.toLocaleString("en-IN");
                }
            });
        });
    });
</script>


